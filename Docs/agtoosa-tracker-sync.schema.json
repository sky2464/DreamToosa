{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgToosa Tracker Sync Bridge",
  "description": "Provider-neutral export and return envelopes for agtoosa.tracker-bridge/v1",
  "oneOf": [
    { "$ref": "#/$defs/export_envelope" },
    { "$ref": "#/$defs/return_envelope" },
    { "$ref": "#/$defs/publish_manifest" },
    { "$ref": "#/$defs/intake_envelope" },
    { "$ref": "#/$defs/discovery_envelope" },
    { "$ref": "#/$defs/bootstrap_input_envelope" },
    { "$ref": "#/$defs/github_issues_fetch_envelope" },
    { "$ref": "#/$defs/linear_fetch_envelope" },
    { "$ref": "#/$defs/status_check_envelope" }
  ],
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "agtoosa.tracker-bridge/v1"
    },
    "story_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$",
      "maxLength": 32
    },
    "status_token": {
      "type": "string",
      "maxLength": 64
    },
    "estimate_token": {
      "type": "string",
      "enum": ["XS", "S", "M", "L", "XL"]
    },
    "acceptance_criterion_ref": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 16 },
        "summary": { "type": "string", "maxLength": 512 }
      }
    },
    "normalized_story": {
      "type": "object",
      "required": [
        "story_id",
        "title",
        "epic",
        "status",
        "estimate",
        "spec_path",
        "acceptance_criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "story_id": { "$ref": "#/$defs/story_id" },
        "title": { "type": "string", "maxLength": 256 },
        "epic": { "type": "string", "maxLength": 64 },
        "status": { "$ref": "#/$defs/status_token" },
        "estimate": { "$ref": "#/$defs/estimate_token" },
        "spec_path": { "type": "string", "maxLength": 512 },
        "acceptance_criteria": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/acceptance_criterion_ref" }
        }
      }
    },
    "export_envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "export_id",
        "generated_at",
        "repository",
        "source",
        "stories"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "export_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "repository": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 256 },
            "remote_url": { "type": "string", "maxLength": 512 }
          }
        },
        "source": {
          "type": "object",
          "required": ["master_plan_sha256"],
          "additionalProperties": false,
          "properties": {
            "commit": { "type": "string", "maxLength": 64 },
            "master_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "stories": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/normalized_story" }
        }
      }
    },
    "change_record": {
      "type": "object",
      "required": [
        "story_id",
        "field",
        "proposed_value",
        "external_ref",
        "observed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "story_id": { "$ref": "#/$defs/story_id" },
        "field": {
          "type": "string",
          "enum": ["title", "status", "estimate", "epic", "spec_path"]
        },
        "proposed_value": { "type": "string", "maxLength": 4096 },
        "external_ref": { "type": "string", "maxLength": 256 },
        "observed_at": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "maxLength": 4096 }
      }
    },
    "return_envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "base_export_id",
        "provider",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "base_export_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provider": {
          "type": "string",
          "enum": ["github-issues", "linear", "jira", "taskmaster", "other"]
        },
        "changes": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/change_record" }
        }
      }
    },
    "issue_payload": {
      "type": "object",
      "required": ["story_id", "upsert_key", "title", "body", "state", "labels"],
      "additionalProperties": false,
      "properties": {
        "story_id": { "$ref": "#/$defs/story_id" },
        "upsert_key": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 256 },
        "body": { "type": "string", "maxLength": 65536 },
        "state": { "type": "string", "enum": ["open", "closed"] },
        "milestone": { "type": ["string", "null"], "maxLength": 64 },
        "labels": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "publish_manifest": {
      "type": "object",
      "required": ["schema_version", "export_id", "generated_at", "issues"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.github-issues-manifest/v1"
        },
        "export_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generated_at": { "type": "string", "format": "date-time" },
        "milestone": { "type": ["string", "null"], "maxLength": 64 },
        "issues": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/issue_payload" }
        }
      }
    },
    "intake_envelope": {
      "type": "object",
      "required": ["schema_version", "issue_number", "title"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.github-issues-intake/v1"
        },
        "issue_number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "maxLength": 256 },
        "body": { "type": "string", "maxLength": 65536 },
        "url": { "type": "string", "maxLength": 512 },
        "labels": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "discovery_signal": {
      "type": "object",
      "required": ["provider", "confidence", "evidence"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["github-issues", "linear", "repo-plans", "master-plan", "other"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "evidence": { "type": "string", "maxLength": 512 }
      }
    },
    "discovery_item": {
      "type": "object",
      "required": ["external_ref", "provider", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "external_ref": { "type": "string", "maxLength": 256 },
        "provider": {
          "type": "string",
          "enum": ["github-issues", "linear", "repo-plans", "other"]
        },
        "title": { "type": "string", "maxLength": 256 },
        "status": {
          "type": "string",
          "enum": ["open", "closed", "unknown"]
        },
        "labels": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 64 }
        },
        "linked_story_id": { "type": ["string", "null"], "maxLength": 32 },
        "body_excerpt": { "type": "string", "maxLength": 1024 }
      }
    },
    "discovery_envelope": {
      "type": "object",
      "required": ["schema_version", "discovered_at", "signals", "items"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.tracker-discovery/v1"
        },
        "discovered_at": { "type": "string", "format": "date-time" },
        "repository": { "type": "string", "maxLength": 512 },
        "signals": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/discovery_signal" }
        },
        "items": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/discovery_item" }
        }
      }
    },
    "bootstrap_input_envelope": {
      "type": "object",
      "required": ["schema_version", "discovery"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.tracker-bootstrap-input/v1"
        },
        "discovery": { "$ref": "#/$defs/discovery_envelope" },
        "github_issues_fetch": { "$ref": "#/$defs/github_issues_fetch_envelope" },
        "linear_fetch": { "$ref": "#/$defs/linear_fetch_envelope" }
      }
    },
    "github_issues_fetch_envelope": {
      "type": "object",
      "required": ["schema_version", "issues"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.github-issues-fetch/v1"
        },
        "fetched_at": { "type": "string", "format": "date-time" },
        "repository": { "type": "string", "maxLength": 256 },
        "issues": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["number", "title", "state"],
            "additionalProperties": true
          }
        }
      }
    },
    "linear_fetch_envelope": {
      "type": "object",
      "required": ["schema_version", "issues"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.linear-fetch-envelope/v1"
        },
        "fetched_at": { "type": "string", "format": "date-time" },
        "team": { "type": "string", "maxLength": 128 },
        "issues": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["identifier", "title"],
            "additionalProperties": true,
            "properties": {
              "identifier": { "type": "string", "maxLength": 32 },
              "title": { "type": "string", "maxLength": 256 },
              "state": { "type": "string", "maxLength": 64 },
              "url": { "type": "string", "maxLength": 512 }
            }
          }
        }
      }
    },
    "status_check_envelope": {
      "type": "object",
      "required": [
        "schema_version",
        "generated_at",
        "project_path",
        "has_tracker_signals",
        "merged_inputs",
        "counts",
        "unlinked_external",
        "finding"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "agtoosa.tracker-status-check/v1"
        },
        "generated_at": { "type": "string", "format": "date-time" },
        "project_path": { "type": "string", "maxLength": 512 },
        "has_tracker_signals": { "type": "boolean" },
        "merged_inputs": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 128 }
        },
        "counts": {
          "type": "object",
          "required": [
            "mirror_skip",
            "new_external",
            "repo_plan",
            "closed_external",
            "unchanged",
            "unsupported"
          ],
          "additionalProperties": false,
          "properties": {
            "mirror_skip": { "type": "integer", "minimum": 0 },
            "new_external": { "type": "integer", "minimum": 0 },
            "repo_plan": { "type": "integer", "minimum": 0 },
            "closed_external": { "type": "integer", "minimum": 0 },
            "unchanged": { "type": "integer", "minimum": 0 },
            "unsupported": { "type": "integer", "minimum": 0 }
          }
        },
        "unlinked_external": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/discovery_item" }
        },
        "finding": {
          "type": "object",
          "required": ["emit", "severity", "count", "sample_refs"],
          "additionalProperties": false,
          "properties": {
            "emit": { "type": "boolean" },
            "severity": { "type": "string", "enum": ["info"] },
            "count": { "type": "integer", "minimum": 0 },
            "sample_refs": {
              "type": "array",
              "maxItems": 5,
              "items": { "type": "string", "maxLength": 256 }
            }
          }
        }
      }
    }
  }
}
